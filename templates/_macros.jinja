{% macro time_readout(label, planned_iso=none, planned_display=none, actual_iso=none, actual_display=none, delay_minutes=none) -%}
    <span class="time{% if delay_minutes %} time--delayed{% endif %}">
        {% if not planned_iso -%}
            <span class="time__none" aria-label="No {{ label | lower }}">n/a</span>
        {%- elif delay_minutes -%}
            <s class="time__planned"><time datetime="{{ planned_iso }}">{{ planned_display }}</time></s>
            <span class="time__actual"><time datetime="{{ actual_iso }}">{{ actual_display }}</time></span>
            <span class="time__delay"
                  aria-label="{{ delay_minutes }} minute{{ 's' if delay_minutes != 1 }} late">+{{ delay_minutes }}</span>
        {%- else -%}
            <span class="time__actual"><time datetime="{{ planned_iso }}">{{ planned_display }}</time></span>
        {%- endif %}
    </span>
{%- endmacro %}

{% macro platform(actual, planned) -%}
    {% if actual == planned -%}
        <span class="platform">{{ actual }}</span>
    {%- else -%}
        <span class="platform platform--changed"><s>{{ planned }}</s> {{ actual }}</span>
    {%- endif %}
{%- endmacro %}

{% macro facility_list(codes) -%}
    {%- set names = {'WIFI': 'Wi-Fi', 'TOILET': 'Toilet', 'STILTE': 'Quiet zone', 'STROOM': 'Power', 'FIETS': 'Bikes', 'TOEGANKELIJK': 'Step-free'} -%}
    {%- set ns = namespace(out=[]) -%}
    {%- for code in codes or [] if code in names -%}
        {%- set ns.out = ns.out + [names[code]] -%}
    {%- endfor -%}
    {{- ns.out | join(", ") -}}
{%- endmacro %}
