{% macro time_readout(label, planned, actual=none, delay_minutes=none) -%}
    {%- set actual = actual or planned -%}
    {%- set delay = delay_minutes if delay_minutes is not none else actual | calculate_delay_minutes(planned) -%}
    <span class="time{% if delay %} time--delayed{% endif %}">
        {% if not planned -%}
        {%- elif delay -%}
            <s class="time__planned"><time datetime="{{ planned | isoformat }}">{{ planned | format_datetime("%H:%M") }}</time></s>
            <span class="time__actual"><time datetime="{{ actual | isoformat }}">{{ actual | format_datetime("%H:%M") }}</time></span>
            <span class="time__delay"><span aria-hidden="true">+{{ delay }}</span><span class="visually-hidden">{{ delay }} minute{{ 's' if delay != 1 }} late</span></span>
        {%- else -%}
            <span class="time__actual"><time datetime="{{ planned | isoformat }}">{{ planned | format_datetime("%H:%M") }}</time></span>
        {%- endif %}
    </span>
{%- endmacro %}

{% macro platform(actual, planned) -%}
    {% if actual == planned -%}
        <span class="platform">{{ actual }}</span>
    {%- else -%}
        <span class="platform platform--changed"><s>{{ planned }}</s> {{ actual }}</span>
    {%- endif %}
{%- endmacro %}

{% macro facility_list(codes) -%}
    {%- set names = {'WIFI': 'Wi-Fi', 'TOILET': 'Toilet', 'STILTE': 'Quiet zone', 'STROOM': 'Power', 'FIETS': 'Bikes', 'TOEGANKELIJK': 'Step-free'} -%}
    {%- set ns = namespace(out=[]) -%}
    {%- for code in codes or [] if code in names -%}
        {%- set ns.out = ns.out + [names[code]] -%}
    {%- endfor -%}
    {{- ns.out | join(", ") -}}
{%- endmacro %}
