{% extends "skeleton.jinja" %}

{% macro nav_link(endpoint, label, blueprints=()) %}
    <a href="{{ url_for(endpoint) }}"
       {% if request.endpoint == endpoint or request.blueprint in blueprints %}aria-current="page"{% endif %}>{{ label }}</a>
{% endmacro %}

{% block body_content %}
    <header class="navbar">
        <div class="navbar__inner">
            <a href="{{ url_for('main.index') }}" class="navbar__brand">{% include "mark.svg" %}Meliag</a>
            <nav class="navbar__links" aria-label="Main navigation">
                {{ nav_link('main.index', 'Home') }}
                {{ nav_link('stations.station_search', 'Stations', ('stations', 'trips')) }}
            </nav>
        </div>
    </header>

    <main class="page">
        {% block content %}{% endblock %}
    </main>

    <footer class="footer">
        <div class="footer__inner">
            <p>
                <a href="{{ url_for('main.index') }}" class="footer__app">{% include "mark.svg" %}Meliag</a> by <a href="https://gijs6.nl">Gijs6</a>
            </p>
            <p>
                <a href="https://unlicense.org" rel="license">Unlicensed</a>
            </p>
        </div>
    </footer>
{% endblock %}
