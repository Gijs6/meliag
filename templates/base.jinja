{% extends "skeleton.jinja" %}

{% from "_macros.jinja" import icon %}

{% block body_class %}page page--topnav{% endblock %}

{% macro nav_link(endpoint, label) %}
    <a href="{{ url_for(endpoint) }}"
       {% if request.endpoint == endpoint %}aria-current="page"{% endif %}>{{ label }}</a>
{% endmacro %}

{% block body_content %}
    <header class="app-bar">
        <a href="{{ url_for('main.index') }}" class="wordmark">
            <span class="wordmark__mark">{{ icon("train-front") }}</span>
            <span class="wordmark__text">Meliag</span>
        </a>

        <nav class="app-bar__nav" aria-label="Main navigation">
            {{ nav_link('main.index', 'Home') }}
            {{ nav_link('stations.station_search', 'Stations') }}
        </nav>
    </header>

    <main class="page__main">
        {% block content %}{% endblock %}
    </main>

    <footer class="site-footer">
        <ul class="site-footer__credits">
            <li>Train times from the <a href="https://www.ns.nl/" rel="noopener">NS</a> API; they can be off or incomplete</li>
        </ul>
        <p class="site-footer__meta">
            <span class="site-footer__id">
                <span class="site-footer__mark">{{ icon("train-front") }}</span>
                <b class="site-footer__name">Meliag</b> by <a class="site-footer__by" href="https://gijs6.nl">Gijs6</a>
            </span>
            <a href="https://unlicense.org" rel="license">Unlicensed</a>
        </p>
    </footer>
{% endblock %}
