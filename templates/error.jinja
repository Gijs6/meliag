{% extends "skeleton.jinja" %}

{% block title %}{{ code }} {{ title }}{% endblock %}

{% block body_content %}
    <header class="navbar">
        <div class="navbar__inner">
            <a href="{{ url_for('main.index') }}" class="navbar__brand">{% include "mark.svg" %}Meliag</a>
        </div>
    </header>

    <main class="page page--narrow error">
        <p class="error__code">{{ code }}</p>
        <h1>{{ title }}</h1>
        <p class="lead">{{ description }}</p>
        <a href="{{ url_for('main.index') }}" class="btn">Go home</a>
    </main>
{% endblock %}
