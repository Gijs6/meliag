{% extends "base.jinja" %}

{% block title %}Home{% endblock %}

{% block content %}
    <div class="page-head">
        <h1>Dutch trains</h1>
    </div>

    <div class="table-wrap">
        <table class="table table--kv table--fit">
            <caption class="visually-hidden">Summary</caption>
            <tbody>
                <tr>
                    <th scope="row">Stations</th>
                    <td>{{ "{:,}".format(stats.total_stations) }}</td>
                </tr>
            </tbody>
        </table>
    </div>
    <p>
        <a class="btn" href="{{ url_for('stations.station_search') }}">Find a station</a>
    </p>
{% endblock %}
