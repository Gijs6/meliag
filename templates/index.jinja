{% extends "base.jinja" %}

{% block title %}Home{% endblock %}

{% block content %}
    <div class="page-head">
        <h1>Dutch trains</h1>
    </div>

    <p class="home__stats">
        <b>{{ "{:,}".format(stats.total_stations) }}</b> stations tracked
    </p>
    <p>
        <a class="btn" href="{{ url_for('stations.station_search') }}">Find a station</a>
    </p>
{% endblock %}
