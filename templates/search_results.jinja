{% if stations %}
    <section class="panel">
        <h2 class="panel__heading">
            <span>Stations <span class="count">{{ "{:,}".format(stations | length) }}</span></span>
        </h2>
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>Station</th>
                        <th>Country</th>
                        <th>UIC code</th>
                    </tr>
                </thead>
                <tbody>
                    {% for station in stations %}
                        <tr>
                            <td>
                                <a href="{{ url_for('stations.station_page', station_code=station.id.uicCode) }}"
                                   lang="nl">{{ station.names.long }}</a>
                            </td>
                            <td>{{ station.country }}</td>
                            <td>
                                <code>{{ station.id.uicCode }}</code>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
{% else %}
    <div class="empty">
        <p class="empty__title">No results</p>
        {% if query %}<p>No station matches "{{ query }}".</p>{% endif %}
    </div>
{% endif %}
