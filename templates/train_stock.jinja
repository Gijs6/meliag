{% from "_macros.jinja" import facility_list %}
{% if error %}
    <span class="stock-note stock-note--error">{{ error }}</span>
{% elif stock and stock.materieeldelen %}
    <span class="stock-note">
        {% for car in stock.materieeldelen -%}
            {{ car.type }} {{ car.materieelnummer }}
            {%- set facilities = facility_list(car.faciliteiten) %}
            {%- if facilities %} ({{ facilities }}){% endif %}
            {%- if not loop.last %}, {% endif %}
        {%- endfor %}
    </span>
{% else %}
    <span class="stock-note">No composition</span>
{% endif %}
