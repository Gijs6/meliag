{% extends "base.jinja" %}

{% from "_macros.jinja" import time_readout, platform, facility_list %}

{% block title %}Train {{ train_number }}{% endblock %}

{% block content %}
    <div class="page-head">
        <h1>Train {{ train_number }}</h1>
    </div>

    {% for note in notes or [] %}
        <div class="alert alert--warning">
            <p>{{ note.message or note.text or note }}</p>
        </div>
    {% endfor %}

    {% set stock = (stops[0].actualStock or stops[0].plannedStock) if stops else none %}
    {% if stock and stock.trainParts %}
        <section class="panel">
            <h2 class="panel__heading">Composition</h2>
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Type</th>
                            <th>Number</th>
                            <th>Facilities</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for part in stock.trainParts %}
                            <tr>
                                <td>{{ stock.trainType }}</td>
                                <td>
                                    <code>{{ part.stockIdentifier }}</code>
                                </td>
                                <td>{{ facility_list(part.facilities) }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    {% endif %}

    {% if error %}
        <div class="alert alert--danger">
            <p>{{ error }}</p>
        </div>
    {% else %}
        <div class="panel">
            <h2 class="panel__heading">Schedule</h2>
            <div class="table-wrap">
                <table class="table route">
                    <thead>
                        <tr>
                            <th>Station</th>
                            <th>Arr</th>
                            <th>Dep</th>
                            <th class="table__num">Platform</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for stop in stops %}
                            {% set arrival = stop.arrivals[0] if stop.arrivals else {} %}
                            {% set departure = stop.departures[0] if stop.departures else {} %}
                            {% set is_passing = (stop.status | lower) == "passing" %}
                            {% set is_cancelled = arrival.cancelled or departure.cancelled %}
                            {% set track = departure.actualTrack or arrival.actualTrack %}
                            {% set planned_track = departure.plannedTrack or arrival.plannedTrack %}
                            <tr class="route__stop{% if is_passing %} route__stop--passing{% endif %}{% if is_cancelled %} route__stop--cancelled{% endif %}">
                                <td class="route__name" lang="nl">
                                    {% if stop.stop.uicCode %}
                                        <a href="{{ url_for('stations.station_page', station_code=stop.stop.uicCode) }}">{{ stop.stop.name }}</a>
                                    {% else %}
                                        {{ stop.stop.name }}
                                    {% endif %}
                                </td>
                                <td>
                                    {% if arrival %}
                                        {{ time_readout("arrival", arrival.plannedTime, arrival.actualTime, (arrival.delayInSeconds / 60) | round | int if arrival.delayInSeconds else 0) }}
                                    {% endif %}
                                </td>
                                <td>
                                    {% if departure %}
                                        {{ time_readout("departure", departure.plannedTime, departure.actualTime, (departure.delayInSeconds / 60) | round | int if departure.delayInSeconds else 0) }}
                                    {% endif %}
                                </td>
                                <td class="table__num">
                                    {% if track and planned_track %}{{ platform(track, planned_track) }}{% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    {% endif %}
{% endblock %}
